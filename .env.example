# Safe configuration template.
# Copy this file to .env only when testing operations that need service credentials.
# Local automated tests (npm install / npm test) do not require .env.
# Setup guide: https://guantou.site/archives/N2CmhISt
# NEVER commit .env or share real Cookies, tokens, passwords, or private links.

# ---------------------------------------------------------------------------
# Cloud-drive provider credentials
# ---------------------------------------------------------------------------

# Aliyun Drive web-session refresh token. Obtain it from the logged-in web app Local Storage token.refresh_token.
# It is a credential derived from the web login session, not the raw HTTP Cookie header.
ALIYUN_REFRESH_TOKEN=""

# Existing folder path inside your Aliyun Drive account; it must already exist.
# Example: /资源下载
ALIYUN_DEFAULT_SAVE_PATH="/影视库"

# Quark web Cookie used to save Quark share links.
QUARK_COOKIE=""

# Baidu Netdisk web Cookie used to save Baidu share links.
# Usually obtained from a logged-in pan.baidu.com browser session.
BAIDU_COOKIE=""

# Default folder inside your Quark cloud-drive account.
# This is NOT an OpenList path or a NAS filesystem path.
# Example: /备份资源
# A provider folder URL may also be accepted by the Quark save workflow.
QUARK_DEFAULT_SAVE_URL="/影视库"

# Default folder inside your Baidu Netdisk account.
# This is NOT an OpenList path or a NAS filesystem path.
# Example: /NAS资源下载
# A provider folder URL may also be accepted by the Baidu save workflow.
BAIDU_DEFAULT_SAVE_PATH="/影视库"

# ---------------------------------------------------------------------------
# OpenList connection and paths
# ---------------------------------------------------------------------------

# OpenList API token. Treat it as a password.
OPENLIST_TOKEN=""

# OpenList service base URL reachable from the computer running this project.
# Example when OpenList runs on this same computer: http://127.0.0.1:5244
# If OpenList runs on your NAS or another host, use that service's reachable URL.
OPENLIST_BASE_URL="http://127.0.0.1:5244"

# Default destination for standalone OpenList copy/backup operations when no target is supplied.
# This is the NAS storage root; media-ingest copies should explicitly target OPENLIST_STAGING_PATH.
OPENLIST_DEFAULT_COPY_DST_PATH="/本地存储"

# OpenList path used as the temporary download/staging area after cloud-drive saves.
# This must be an OpenList mount path, NOT a Windows path or NAS local filesystem path.
OPENLIST_STAGING_PATH="/本地存储/Downloads"

# OpenList path for the final Movies media library.
MEDIA_MOVIES_PATH="/本地存储/Movies"

# OpenList path for the final TVShows media library.
MEDIA_TVSHOWS_PATH="/本地存储/TVShows"

# ---------------------------------------------------------------------------
# Local application task metadata (not media files)
# ---------------------------------------------------------------------------

# Local JSON file storing media-ingest task records.
# Keep it outside the media library. For OpenClaw/Hermes shared processing,
# both agents must use the same persistent mounted location.
MEDIA_TASK_STORE_PATH=".state/media-tasks.json"

# Local directory storing application resource locks.
# Keep it outside the media library and share it with the task store.
MEDIA_TASK_LOCK_DIR=".state/locks"

# Optional local alias catalog for homophones, transliterations, and alternate titles.
MEDIA_TITLE_ALIASES_FILE="config/media-title-aliases.json"
